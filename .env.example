# Copy this file to .env and adjust it. Docker Compose reads .env automatically.

# Database password (required). Use a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Database user and name. The defaults are fine; change them only before
# the first start (PostgreSQL creates them once, with the data volume).
# POSTGRES_USER=mercadito
# POSTGRES_DB=mercadito

# Time zone used for "today", expiry warnings, and the weekly plan.
# Examples: America/Guayaquil, America/Mexico_City, America/Bogota,
# America/Argentina/Buenos_Aires, Europe/Madrid, America/New_York
TZ=UTC

# Who can open the app:
#   127.0.0.1 -> only this computer (default, safest)
#   0.0.0.0   -> any device on your home network (see README: "Use it from your phone")
BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Development only (docker-compose.dev.yml): host port for PostgreSQL.
# POSTGRES_PORT=5432
